# Roomscape environment — copy to .env and fill in.
# Secrets live HERE, never in JSON config files.

# --- Conductor ---
PORT=8090
# APP_DIR=/app            # usually set by Docker; leave unset for bare-node runs
# DATA_DIR=               # THE writable state root (v1.03): admin-token, state,
#                         # profiles, every JSON store the Conductor writes, the
#                         # _backups folder and the .thumbs cache all live here.
#                         # Defaults to <APP_DIR>/data; docker/compose.yaml sets
#                         # /app/data, deliberately OUTSIDE the folder served
#                         # over HTTP. APP_DIR is mounted read-only under Docker,
#                         # so nothing writable may sit inside it.
# MEDIA_DIR=              # your scene library. Defaults to <APP_DIR>/media.
#                         # If you are upgrading an install that still uses the
#                         # old "Images & Videos" folder name, that folder is
#                         # picked up automatically as long as media/ is absent —
#                         # the boot banner says which one it chose.
# BACKUP_DIR=             # defaults to <DATA_DIR>/_backups
# THUMB_DIR=              # defaults to <DATA_DIR>/.thumbs

# --- Admin token (optional) ---
# Every API call that CHANGES something needs this token (x-rs-token header, or
# ?token= — see SECURITY.md). Since 1.01 that includes the handful of mutating
# routes that answer GET (/api/panic, /api/kid, /api/rescan, /api/warmthumbs,
# /api/game/*, /api/mode/*), NFC tag taps (/api/tag/*), and any WebSocket that
# wants to publish state. Leave unset and the conductor generates one on first
# run, prints it in the boot log, and saves it to <DATA_DIR>/admin-token. Set it
# here to pin or rotate it explicitly (the env var overrides the file).
# ADMIN_TOKEN=

# --- Home Assistant (required) ---
# Create a long-lived access token: HA -> your profile -> Security -> Long-lived access tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Music Assistant (optional — music features hide if unset) ---
MA_URL=http://homeassistant.local:8095
MA_TOKEN=

# --- MQTT bridge to HA (optional) ---
# MQTT_URL=mqtt://homeassistant.local:1883
# MQTT_PREFIX=roomscape
