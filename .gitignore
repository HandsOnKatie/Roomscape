# --- secrets & local config (never commit) ---
.env
.env.*
!.env.example
config.json
config.json.*.bak

# --- runtime data (machine-local) ---
# v1.03: DATA_DIR is the single writable state root (stores, backups, thumbs,
# admin-token). The FOLDER is tracked (docker/compose.yaml mounts it); its
# CONTENTS never are.
data/*
!data/.gitkeep
state.json
modeposters.json
_inventory.json
_backups/
.thumbs/

# --- user media (yours, not the repo's) ---
# v1.03: same deal — media/ is the default MEDIA_DIR and compose mounts it, so
# the folder must exist in a fresh clone; nothing inside it is ever committed.
media/*
!media/.gitkeep
Photos/
# score-card portraits (written by POST /api/people/photo, served from /people/)
people/*
!people/.gitkeep
sounds/*
!sounds/starter/
overlays/*
!overlays/.gitkeep

# media file types anywhere outside themes/
*.mp4
*.mov
*.webm
*.mp3
*.wav
*.flac
!themes/**/*.mp4
!themes/**/*.mp3
!themes/**/*.wav
!sounds/starter/**

# --- node ---
node_modules/
npm-debug.log

# --- OS noise ---
Thumbs.db
.DS_Store
